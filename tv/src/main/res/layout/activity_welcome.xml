<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night">

    <app.himalayandawn.tv.SceneView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B814162B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingEnd="72dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Dawn.Text.Devanagari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="true"
                android:text="@string/greeting"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/greetingSub"
                style="@style/Dawn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mukta_light"
                android:textColor="@color/snow_dim"
                android:textSize="17sp" />

            <View
                android:layout_width="90dp"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:alpha="0.6"
                android:background="@color/saffron" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clockTime"
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mukta_extralight"
                    android:textSize="60sp" />

                <TextView
                    android:id="@+id/clockAmPm"
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/mukta_light"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/adDate"
                style="@style/Dawn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bsDate"
                    style="@style/Dawn.Text.Devanagari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontVariationSettings="'wght' 500"
                    android:includeFontPadding="true"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/bsYearDay"
                    style="@style/Dawn.Text.Devanagari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:includeFontPadding="true"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tithiLine"
                style="@style/Dawn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/saffron"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nepal_time"
                    android:textColor="@color/snow_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/nepalTime"
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/nepalAmPm"
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/family"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:background="@drawable/tile_bg"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_family"
                    android:tint="@color/tile_icon" />

                <TextView
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/mukta_medium"
                    android:text="@string/family"
                    android:textColor="@color/tile_icon"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kids"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/tile_bg"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_child"
                    android:tint="@color/tile_icon" />

                <TextView
                    style="@style/Dawn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/mukta_medium"
                    android:text="@string/kids"
                    android:textColor="@color/tile_icon"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
