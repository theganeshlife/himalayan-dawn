<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:clipChildren="false">

    <app.himalayandawn.tv.SceneView
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <!-- Local clock and AD date -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clockTime"
                style="@style/Dawn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mukta_extralight"
                android:letterSpacing="-0.02"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/clockAmPm"
                style="@style/Dawn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/mukta_light"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/adDate"
            style="@style/Dawn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/localLabel"
            style="@style/Dawn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/mukta_light"
            android:textColor="@color/snow_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bikram Sambat card and festivals -->
    <LinearLayout
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical">

        <include layout="@layout/calendar_card" />

        <TextView
            android:id="@+id/festivalHeader"
            style="@style/Dawn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/mukta_medium"
            android:letterSpacing="0.1"
            android:text="@string/upcoming_festivals"
            android:textColor="@color/snow_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/festivalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Gentle low-storage notice -->
    <TextView
        android:id="@+id/storageNotice"
        style="@style/Dawn.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="200dp"
        android:background="@drawable/card_bg"
        android:maxWidth="420dp"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Bottom: Dhaka band, app tiles, scene caption -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <app.himalayandawn.tv.DhakaBandView
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:alpha="0.75" />

        <HorizontalScrollView
            android:id="@+id/tileScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="0dp"
            android:paddingStart="44dp"
            android:paddingTop="18dp"
            android:paddingEnd="44dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/sceneCaption"
            style="@style/Dawn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/mukta_light"
            android:textColor="@color/snow_dim"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
