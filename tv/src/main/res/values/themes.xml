<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dawn" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorAccent">@color/saffron</item>
        <item name="android:fontFamily">@font/mukta_regular</item>
        <item name="android:textColor">@color/snow</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Dawn.Text" parent="">
        <item name="android:textColor">@color/snow</item>
        <item name="android:fontFamily">@font/mukta_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dawn.Text.Devanagari">
        <item name="android:fontFamily">@font/noto_serif_devanagari</item>
        <item name="android:textColor">@color/blush</item>
    </style>

    <style name="Dawn.Button" parent="">
        <item name="android:background">@drawable/tile_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:fontFamily">@font/mukta_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
